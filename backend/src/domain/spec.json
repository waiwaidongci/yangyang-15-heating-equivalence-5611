{
  "organization": "森井地暖",
  "tagline": "并行巡检规程工时等效复核",
  "source": "森井地暖运维组、区段双规程计时工单（模拟）",
  "record_name": "区段计时工单",
  "algorithm": "同一区段配对差的双单侧 t 等效检验（TOST），跨全部有效配法核对裁决一致",
  "formula": "每区段工时差 d = 新规程 − 旧规程。较低等效界为 −Δ，较高等效界为 +Δ。以 s(d)/√n 为标准误，两次单侧 t 检验分别检验均差高于 −Δ、低于 +Δ。两项均通过时判定等效。同一批次的补测会使一个区段出现多张有效计时，新旧各取一张形成一种配法；只有全部配法的裁决一致时才给出结论。",
  "decision_prompt": "同一批地暖区段换用并行巡检规程后，平均工时差能否控制在预先登记的分钟容许范围内？",
  "ticket_fields": [
    {
      "key": "code",
      "label": "工单编号",
      "type": "text",
      "example": "SJ-0111-O-01",
      "help": "批次内唯一，用于更正和撤回引用。"
    },
    {
      "key": "segment",
      "label": "巡检区段编号",
      "type": "text",
      "example": "SJ-01",
      "help": "同一批次的同一区段配一对新旧计时。"
    },
    {
      "key": "kind",
      "label": "计时类别",
      "type": "choice",
      "choices": [
        {
          "value": "initial",
          "label": "首次计时"
        },
        {
          "value": "retest",
          "label": "补测"
        },
        {
          "value": "correction",
          "label": "更正"
        },
        {
          "value": "withdrawal",
          "label": "撤回"
        }
      ],
      "default": "initial"
    },
    {
      "key": "minutes",
      "label": "计时（分钟）",
      "type": "number",
      "min": 0.01,
      "max": 480,
      "example": 24.0,
      "help": "撤回工单不填计时。"
    },
    {
      "key": "inspected_on",
      "label": "计时日期",
      "type": "date",
      "example": "2026-11-17"
    },
    {
      "key": "target_code",
      "label": "被更正或撤回的工单编号",
      "type": "text",
      "required": false,
      "example": "SJ-0111-O-01"
    },
    {
      "key": "note",
      "label": "备注",
      "type": "text",
      "required": false,
      "example": ""
    }
  ],
  "parameters": [
    {
      "key": "margin_minutes",
      "label": "可接受的平均工时差（±分钟）",
      "type": "number",
      "min": 0.01,
      "max": 120,
      "default": 2,
      "help": "须在看数据之前确定。填 2 表示等效区间 (−2, +2) 分钟。"
    },
    {
      "key": "alpha",
      "label": "单侧显著性水平 α",
      "type": "number",
      "min": 0.001,
      "max": 0.2,
      "default": 0.05,
      "help": "每个单侧检验使用同一个 α，0.05 对应 90% 置信区间。"
    }
  ]
}
